# Copy this file to .env and replace placeholders locally. Never commit .env.
# Preferred connection URL for Neon; if omitted, a PostgreSQL DATABASE_URL may be used.
NEON_DATABASE_URL=
# Fallback only; values with a non-PostgreSQL scheme are rejected.
DATABASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Do not store this in .env or a hosting environment. Set it in the current shell only
# for a migration you have intentionally reviewed and approved.
# CONFIRM_NEON_MIGRATIONS=1
